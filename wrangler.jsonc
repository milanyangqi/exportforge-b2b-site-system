{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yuvacosmetics-024",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-05-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "yuvacosmetics-024"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "EXPORTFORGE_KV",
      "id": "aff525e11b804b22a3342840e226c5b0"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://yuvacosmetics.com",
    "INITIAL_ADMIN_EMAIL": "437991663@qq.com"
  },
  "routes": [
    {
      "pattern": "yuvacosmetics.com",
      "custom_domain": true
    },
    {
      "pattern": "www.yuvacosmetics.com",
      "custom_domain": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "YUVA_MEDIA",
      "bucket_name": "yuvacosmetics-024-media"
    }
  ]
}
