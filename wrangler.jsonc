{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "loftyvista-027",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "loftyvista-027"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "EXPORTFORGE_KV",
      "id": "6c4f0fe1387d471484c48a0aa9cbf5a8"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://loftyvista-027.437991663.workers.dev",
    "NEXT_PUBLIC_SITE_INDEXABLE": "false",
    "INITIAL_ADMIN_EMAIL": "admin@loftyvista.com"
  }
}
