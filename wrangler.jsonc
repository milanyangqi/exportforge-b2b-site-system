{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xiyida-packaging-site",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-05-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "xiyida-packaging-site"
    }
  ],
  "routes": [
    {
      "pattern": "xiyidapackaging.com",
      "custom_domain": true
    },
    {
      "pattern": "www.xiyidapackaging.com/*",
      "zone_name": "xiyidapackaging.com"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "EXPORTFORGE_KV",
      "id": "e9e86fb038ac47da88ecabd510875fef"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://www.xiyidapackaging.com",
    "INITIAL_ADMIN_EMAIL": "admin@example.com"
  }
}
