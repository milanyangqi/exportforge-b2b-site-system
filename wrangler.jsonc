{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cedarorigin-029",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "cedarorigin-029"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "EXPORTFORGE_KV",
      "id": "4801de4bb88c44909a9e204157993dc5"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://cedarorigin-029.437991663.workers.dev",
    "NEXT_PUBLIC_SITE_INDEXABLE": "false"
  }
}
