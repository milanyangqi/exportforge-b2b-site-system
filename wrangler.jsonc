{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rivermake-028",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "rivermake-028"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "EXPORTFORGE_KV",
      "id": "db883585d62c47559fd1472441efa5a1"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://rivermake-028.437991663.workers.dev",
    "NEXT_PUBLIC_SITE_INDEXABLE": "false",
    "INITIAL_ADMIN_EMAIL": "437991663@qq.com"
  }
}
