{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dawnorigin-026",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "dawnorigin-026"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "EXPORTFORGE_KV",
      "id": "42400bc7a9bb4c878c029d467c6e8f72"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://dawnorigin-026.437991663.workers.dev",
    "NEXT_PUBLIC_SITE_INDEXABLE": "false",
    "INITIAL_ADMIN_EMAIL": "admin@dawnorigin.com"
  }
}
