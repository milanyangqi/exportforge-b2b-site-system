  "pages": [
    {
      "id": "river-page-about",
      "slug": "about",
      "title": {
        "en": "A quieter kind of beauty.",
        "zh": "一份更从容的美。"
      },
      "excerpt": {
        "en": "Meet the ideas behind Rivermake.",
        "zh": "认识 Rivermake 的灵感。"
      },
      "body": {
        "en": "## What Rivermake is about\nRivermake is a concept for textile pieces that bring tactile warmth to everyday spaces. The collection shown on this site is illustrative while the final product range is confirmed.\n\n## Our point of view\nWe draw inspiration from the garden: soft greens, warm neutrals, and small floral details. Every piece deserves clear photographs, useful information, and a place in real life.",
        "zh": "## 关于 Rivermake\nRivermake 以织物与编织带来的温润触感为灵感。网站展示的系列目前为视觉示意，实际产品范围需要进一步确认。\n\n## 我们的视觉语言\n取色于花园：柔和的绿色、温暖的中性色和细小花卉纹理。"
      },
      "status": "published",
      "publishedAt": "2026-09-24T00:00:00Z"
    },
    {
      "id": "river-page-process",
      "slug": "process",
      "title": {
        "en": "The beauty is in the making.",
        "zh": "美感藏在制作细节里。"
      },
      "excerpt": {
        "en": "A closer look at textile texture and the making process.",
        "zh": "看看织物纹理与制作过程。"
      },
      "body": {
        "en": "## Start with the material\nYarn weight, fibre composition, colour and stitch pattern shape how a textile looks and feels.\n\n## Consider the details\nEdges, texture, care instructions and dimensions should be confirmed for each final product. Contact us to discuss a specific brief.",
        "zh": "## 从材料开始\n纱线粗细、纤维成分、颜色和针法共同决定织物的观感与手感。\n\n## 关注细节\n实际产品的收边、纹理、护理方式与尺寸需要逐一确认。欢迎联系我们讨论具体需求。"
      },
      "status": "published",
      "publishedAt": "2026-09-24T00:00:00Z"
    }
  ],
