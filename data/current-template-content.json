  "articles": [],
  "pages": [
    {
      "id": "dawn-page-oem-odm",
      "slug": "oem-odm",
      "title": {
        "en": "Create a collection of your own.",
        "zh": "打造属于您的发饰系列。"
      },
      "excerpt": {
        "en": "Explore design, materials and packaging as a starting point for your brief.",
        "zh": "从设计、材质到包装，梳理您的系列需求。"
      },
      "body": {
        "en": "## Start with the idea\nShare reference styles, intended customer, colors and desired finish.\n\n## Review a sample\nConfirm material, fastening, comfort and packaging details against an agreed sample.\n\n## Plan the order\nDiscuss quantities, timing and logistics directly before any production commitment.",
        "zh": "## 从构想开始\n提供参考款式、目标客群、颜色和外观要求。\n\n## 确认样品\n依据双方确认的样品核对材质、固定方式、佩戴体验与包装。\n\n## 讨论订单\n在生产承诺前确认数量、时间和物流需求。"
      },
      "status": "published",
      "publishedAt": "2026-09-24T05:00:00Z"
    },
    {
      "id": "dawn-page-about",
      "slug": "about",
      "title": {
        "en": "Details that make a difference.",
        "zh": "让细节成就更好的系列。"
      },
      "excerpt": {
        "en": "Hair accessories and thoughtful details for your next collection.",
        "zh": "以发饰与细节构成您的下一套系列。"
      },
      "body": {
        "en": "## Our direction\nLoftyVista focuses on bows, clips, claws, pins and hair ties, bringing a considered finishing touch to each collection.\n\n## Work together\nShare design references, material preferences and presentation needs. We will discuss a clear path from sample to order.",
        "zh": "## 品牌方向\nLoftyVista 聚焦蝴蝶结、发夹、抓夹、发簪与发圈，以精心设计的细节完善品牌系列。\n\n## 合作方式\n欢迎沟通设计参考、材质偏好和呈现要求，共同明确从样品到订单的路径。"
      },
      "status": "published",
      "publishedAt": "2026-09-24T05:00:00Z"
    },
    {
      "id": "dawn-page-factories",
      "slug": "factories",
      "title": {
        "en": "From concept to finish.",
        "zh": "从构想到成品细节。"
      },
      "excerpt": {
        "en": "Explore the making process behind LoftyVista hair accessories.",
        "zh": "了解 LoftyVista 发饰的制作流程。"
      },
      "body": {
        "en": "## From materials to finishing\nOur factory brings together material selection, sample development, assembly, finishing and packing for hair accessories.\n\n## A clear production brief\nWe review style references, fastening, appearance and packaging requirements with buyers before production.",
        "zh": "## 从选材到成品\n我们的工厂围绕发饰开展选材、打样、组装、修整与包装。\n\n## 明确生产需求\n生产前与采购方核对款式参考、固定方式、外观和包装要求。"
      },
      "status": "published",
      "publishedAt": "2026-09-24T05:00:00Z"
    },
    {
      "id": "dawn-page-research",
      "slug": "research",
      "title": {
        "en": "Care in every detail.",
        "zh": "认真对待每一处细节。"
      },
      "excerpt": {
        "en": "Agree materials, samples and inspection criteria for each accessory type.",
        "zh": "针对不同发饰，确认材质、样品与检验标准。"
      },
      "body": {
        "en": "## Material and feel\nWe focus on fabric hand feel, clip tension, edges, surface finish and comfort where accessories meet the hair.\n\n## Samples and inspection\nWe use approved samples and agreed acceptance points to guide quality checks for each order.",
        "zh": "## 材质与佩戴体验\n关注面料手感、夹力、边缘、表面处理以及发饰接触头发时的舒适度。\n\n## 样品与检验\n依据确认样品和双方约定的验收项目检查订单品质。"
      },
      "status": "published",
      "publishedAt": "2026-09-24T05:00:00Z"
    },
    {
      "id": "dawn-page-privacy",
      "slug": "privacy",
      "title": {
        "en": "Inquiry privacy",
        "zh": "询盘隐私"
      },
      "excerpt": {
        "en": "How inquiry information is handled.",
        "zh": "询盘信息的使用说明。"
      },
      "body": {
        "en": "## Inquiry data\nThe form collects the name, company, email and project details you choose to provide. We use these details to respond to your inquiry and discuss your project.",
        "zh": "## 询盘数据\n表单收集您主动提交的姓名、公司、邮箱和项目需求，用于回复询盘和沟通项目。"
      },
      "status": "published",
      "publishedAt": "2026-09-24T05:00:00Z"
    }
  ],
